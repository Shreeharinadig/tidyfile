# Copy to .env and fill in. Never commit .env.

# Database (development defaults; change for any shared or deployed environment)
DB_ADMIN_USER=tidyfile_admin
DB_ADMIN_PASSWORD=change-me
DB_APP_USER=tidyfile_app
DB_APP_PASSWORD=change-me

AWS_REGION=ap-south-1

# LLM provider (week 5). Leave empty until then.
LLM_API_KEY=
LLM_MODEL=
# Set a hard monthly spend limit in the provider console as well.
LLM_MAX_TOKENS_PER_RUN=20000
LLM_MAX_TOKENS_PER_TENANT_PER_DAY=200000
